<Window x:Class="PromptCrew.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:PromptCrew.Desktop.ViewModels" Title="PromptCrew · AI 员工提示词工作台" Width="1440" Height="920" MinWidth="1160" MinHeight="740"
 Background="#F5F7F2" Foreground="#193729" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <vm:InverseBooleanConverter x:Key="Inverse"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#DEE6D9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#73816A"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#64765D"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#D2F580"/><Setter Property="Foreground" Value="#193729"/><Setter Property="Padding" Value="20,12"/></Style>
  <Style x:Key="ReadOnly" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Background" Value="#F7F9F3"/><Setter Property="Padding" Value="12"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}"/><Setter Property="Padding" Value="3,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <HierarchicalDataTemplate DataType="{x:Type vm:RoundNode}" ItemsSource="{Binding Children}">
   <StackPanel Margin="3,3,0,7"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
  </HierarchicalDataTemplate>
  <Style TargetType="TabItem"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,3"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#9EC956"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
  <Border Background="#193729" Padding="28,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="▰" Foreground="#D2F580" FontSize="27" Margin="0,-3,10,0"/><TextBlock Text="PromptCrew" Foreground="White" FontSize="23" FontWeight="SemiBold"/><Border Background="#34533D" CornerRadius="5" Padding="8,3" Margin="15,3,0,0"><TextBlock Text="AI 员工工作台" Foreground="#D2F580" FontSize="10"/></Border></StackPanel><TextBlock Text="让每一次提示、交接与修订都有迹可循。" Foreground="#B8C8AE" FontSize="11" Margin="1,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="连接设置" Command="{Binding ConnectionCommand}" Background="#33513D" Foreground="White" Margin="0,0,8,0"/><Button Content="API Key" Command="{Binding KeysCommand}" Background="#33513D" Foreground="White" Margin="0,0,8,0"/><Button Content="刷新工作台" Command="{Binding RefreshCommand}" Background="#D2F580"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="238" MinWidth="210"/><ColumnDefinition Width="12"/><ColumnDefinition Width="292" MinWidth="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="560"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel>
     <Grid Margin="0,0,0,13"><TextBlock Text="项目空间" FontSize="17" FontWeight="SemiBold"/><Button Content="＋" HorizontalAlignment="Right" Command="{Binding NewProjectCommand}" Style="{StaticResource Quiet}" Padding="8,1" FontSize="18" AutomationProperties.Name="新建项目"/></Grid>
     <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelectWorkspace}" AutomationProperties.Name="当前项目"/>
     <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Caption}" Margin="0,13,0,8"/>
     <Button Content="项目目标与背景  ↗" Command="{Binding EditProjectCommand}" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,8"/>
    </StackPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><TextBlock Text="我的 AI 团队" FontSize="17" FontWeight="SemiBold"/><Button Content="＋" HorizontalAlignment="Right" Command="{Binding NewEmployeeCommand}" Style="{StaticResource Quiet}" Padding="8,1" FontSize="18" AutomationProperties.Name="新建员工"/></Grid>
     <ListBox Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" BorderThickness="0" Background="Transparent" IsEnabled="{Binding CanSelectWorkspace}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="员工列表">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Role}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding CountLabel}" Style="{StaticResource Caption}"/><Button Content="编辑员工职责与 Skills" Command="{Binding EditEmployeeCommand}" Style="{StaticResource Quiet}" Margin="0,8,0,0"/></StackPanel>
    </Grid></Border>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14"><TextBlock Text="任务链" FontSize="19" FontWeight="SemiBold"/><Button Content="＋ 新建" Command="{Binding NewChainCommand}" Style="{StaticResource Quiet}" HorizontalAlignment="Right"/></Grid>
    <ComboBox Grid.Row="1" ItemsSource="{Binding Chains}" SelectedItem="{Binding SelectedChain}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelectWorkspace}" AutomationProperties.Name="当前任务链"/>
    <StackPanel Grid.Row="2" Margin="0,13,0,16"><TextBlock Text="{Binding ChainSummary}" Style="{StaticResource Caption}" MaxHeight="76"/><Button Content="编辑任务与完成标准" Command="{Binding EditChainCommand}" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,8"/></StackPanel>
    <TreeView Grid.Row="3" x:Name="RoundTree" ItemsSource="{Binding Roots}" SelectedItemChanged="RoundSelected" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="提示词分支树"/>
    <TextBlock Grid.Row="4" Text="点击节点查看记录。继续、分支与输入修订都会保留原记录。" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
   </Grid></Border>
   <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="协作记录" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding RecordTitle}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="从此轮继续" Command="{Binding ContinueCommand}" Style="{StaticResource Quiet}" Click="GoCompose"/><Button Content="修订输入" Command="{Binding ReviseCommand}" Style="{StaticResource Quiet}" Click="GoCompose"/></StackPanel></Grid>
    <Border Grid.Row="1" Background="#FFF1DA" CornerRadius="7" Padding="12" Margin="0,0,0,10" Visibility="{Binding HasPending,Converter={StaticResource Visible}}"><DockPanel><Button Content="检查保存状态 / 解锁草稿" DockPanel.Dock="Right" Command="{Binding ResolvePendingCommand}" Style="{StaticResource Quiet}"/><TextBlock Text="有待确认的请求，重试会保留原请求 ID。" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
    <TabControl Grid.Row="2" x:Name="EditorTabs" BorderThickness="0" Background="White" SelectionChanged="EditorTabChanged">
     <TabItem Header="编写提示词"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="#EDF3E3" CornerRadius="8" Padding="13" Margin="0,0,0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CurrentEmployeeLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="{Binding ParentLabel}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding RevisionLabel}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="设为首轮" Command="{Binding RootCommand}" Style="{StaticResource Quiet}"/></Grid></Border>
      <TextBox Grid.Row="1" Text="{Binding DraftInput,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="{Binding CanEditDraft,Converter={StaticResource Inverse}}" FontSize="14" Padding="14" MaxLength="100000" AutomationProperties.Name="本轮提示词"/>
      <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="模型名称（可选）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DraftModel,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanEditDraft,Converter={StaticResource Inverse}}" AutomationProperties.Name="模型名称"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="标签 · 逗号分隔" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DraftTags,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanEditDraft,Converter={StaticResource Inverse}}" AutomationProperties.Name="标签"/></StackPanel></Grid>
      <Grid Grid.Row="3" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Expander Header="成果引用与备注" Margin="0,0,12,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="引用轮次 ID · 可跨任务链，须属于当前项目" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DraftReferences,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanEditDraft,Converter={StaticResource Inverse}}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="引用轮次"/><TextBlock Text="备注" Style="{StaticResource FieldLabel}" Margin="0,10,0,7"/><TextBox Text="{Binding DraftNotes,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanEditDraft,Converter={StaticResource Inverse}}" AutomationProperties.Name="轮次备注"/></StackPanel></Expander><Button Grid.Column="1" Content="{Binding SaveRoundLabel}" Command="{Binding SaveRoundCommand}" Style="{StaticResource Primary}" VerticalAlignment="Bottom"/></Grid>
     </Grid></TabItem>
     <TabItem Header="记录与输出"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,8,0">
      <TextBlock Text="{Binding RecordMetadata}" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
      <Expander Header="原始输入与员工提示词快照" IsExpanded="False"><StackPanel Margin="0,10,0,12"><TextBox Text="{Binding RecordInput,Mode=OneWay}" Style="{StaticResource ReadOnly}" MinHeight="90" MaxHeight="230"/><TextBlock Text="员工基础提示词快照" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBox Text="{Binding RecordBasePrompt,Mode=OneWay}" Style="{StaticResource ReadOnly}" MaxHeight="160"/></StackPanel></Expander>
      <TextBlock Text="历史结果版本" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/><ComboBox ItemsSource="{Binding SelectedRound.Results}" SelectedItem="{Binding SelectedResultVersion}" DisplayMemberPath="Version" AutomationProperties.Name="历史结果版本"/>
      <TextBlock Text="{Binding HistoricalNote}" Style="{StaticResource Caption}" Margin="0,9,0,8"/><TextBox Text="{Binding HistoricalOutput,Mode=OneWay}" Style="{StaticResource ReadOnly}" MinHeight="90" MaxHeight="220" AutomationProperties.Name="历史输出"/>
      <TextBlock Text="补充或修正输出 · 创建新版本" FontWeight="SemiBold" FontSize="15" Margin="0,20,0,10"/><TextBox Text="{Binding DraftOutput,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" MaxHeight="300" IsReadOnly="{Binding HasPending}" AutomationProperties.Name="本轮输出"/>
      <TextBlock Text="成果路径或 URL · 逗号或换行分隔" Style="{StaticResource FieldLabel}" Margin="0,12,0,7"/><TextBox Text="{Binding DraftArtifacts,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanEditDraft,Converter={StaticResource Inverse}}" AutomationProperties.Name="输出成果引用"/>
      <TextBlock Text="修正说明 / 失败原因" Style="{StaticResource FieldLabel}" Margin="0,12,0,7"/><TextBox Text="{Binding ResultNote,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanEditDraft,Converter={StaticResource Inverse}}" AutomationProperties.Name="结果说明"/>
      <DockPanel Margin="0,14,0,12"><Button DockPanel.Dock="Right" Content="{Binding SaveResultLabel}" Command="{Binding SaveResultCommand}" Style="{StaticResource Primary}"/><ComboBox Width="130" HorizontalAlignment="Left" ItemsSource="{Binding ResultStates}" SelectedValue="{Binding ResultStatus}" SelectedValuePath="Value" DisplayMemberPath="Label" IsEnabled="{Binding CanSelectWorkspace}" AutomationProperties.Name="结果状态"/></DockPanel>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="分支上下文"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding EmployeeDescription}" Style="{StaticResource Caption}" MaxHeight="130"/>
      <DockPanel Grid.Row="1" Margin="0,12,0,12"><Button DockPanel.Dock="Right" Content="生成当前分支上下文" Command="{Binding ContextCommand}"/><TextBlock Text="依据编写区的父节点，合并祖先链与显式成果引用。" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
      <TextBox Grid.Row="2" Text="{Binding CompiledContext,Mode=OneWay}" Style="{StaticResource ReadOnly}" AutomationProperties.Name="分支上下文"/>
     </Grid></TabItem>
     <TabItem Header="版本对比"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="比较" Command="{Binding CompareCommand}" Margin="10,0,0,0"/><ComboBox ItemsSource="{Binding ComparisonOptions}" SelectedItem="{Binding ComparisonTarget}" DisplayMemberPath="Label" AutomationProperties.Name="对比轮次"/></DockPanel><TextBlock Grid.Row="1" Text="输入差异 · − 旧内容 / + 新内容" Style="{StaticResource FieldLabel}" Margin="0,15,0,8"/><TextBox Grid.Row="2" Text="{Binding InputDiff,Mode=OneWay}" Style="{StaticResource ReadOnly}"/><TextBlock Grid.Row="3" Text="最新输出差异" Style="{StaticResource FieldLabel}" Margin="0,15,0,8"/><TextBox Grid.Row="4" Text="{Binding OutputDiff,Mode=OneWay}" Style="{StaticResource ReadOnly}"/></Grid></TabItem>
     <TabItem Header="搜索"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="搜索" Command="{Binding SearchCommand}" Margin="10,0,0,0"/><TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索正文"/></DockPanel>
      <Grid Grid.Row="1" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SearchEmployee}" DisplayMemberPath="Name" AutomationProperties.Name="搜索员工"/><ComboBox Grid.Column="2" ItemsSource="{Binding SearchStates}" SelectedItem="{Binding SearchState}" DisplayMemberPath="Label" AutomationProperties.Name="搜索状态"/><TextBox Grid.Column="4" Text="{Binding SearchTag}" ToolTip="精确标签" AutomationProperties.Name="搜索标签"/><Button Grid.Column="5" Content="清除" Style="{StaticResource Quiet}" Click="ClearSearch"/></Grid>
      <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}" MouseDoubleClick="OpenSearchResult" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="搜索结果"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,12"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Input}" MaxHeight="48" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid></TabItem>
    </TabControl>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="2" Background="#EAF0E3" Padding="23,10"><Grid><TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="处理中…" HorizontalAlignment="Right" FontSize="11" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}"/></Grid></Border>
 </Grid>
</Window>
