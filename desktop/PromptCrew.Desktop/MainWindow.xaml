<Window x:Class="PromptCrew.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:PromptCrew.Desktop.Views" Title="PromptCrew · AI 员工提示词工作台" Width="1440" Height="920" MinWidth="1160" MinHeight="740"
 WindowStartupLocation="CenterScreen" Background="#F5F7F2" Foreground="#193729" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style x:Key="OverviewNavigation" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="14"/><Style.Triggers><DataTrigger Binding="{Binding IsOverview}" Value="True"><Setter Property="Background" Value="#E6EFD9"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="EmployeeNavigation" TargetType="Button" BasedOn="{StaticResource ActivityButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,0,4"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#E6EFD9"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Background="#F5F7F2"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border Background="#193729" Padding="26,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="▰" Foreground="#D2F580" FontSize="28" Margin="0,-3,10,0"/><TextBlock Text="PromptCrew" FontSize="23" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="每名员工，一条清晰的工作轨迹。" Foreground="#BCCBAF" FontSize="11" Margin="20,8,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="连接与权限" Click="OpenSettings" Background="#33513D" Foreground="White" Margin="0,0,10,0"/><Button Content="刷新记录" Command="{Binding RefreshCommand}" Background="#D2F580"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="4,2,4,0"><TextBlock Text="项目空间" Style="{StaticResource Caption}" Margin="0,0,0,10"/><ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelectWorkspace}" AutomationProperties.Name="当前项目"/></StackPanel>
    <Button Grid.Row="1" Content="▦   总览" Command="{Binding OverviewCommand}" Style="{StaticResource OverviewNavigation}" Margin="0,22,0,15" AutomationProperties.Name="项目总览"/>
    <Grid Grid.Row="2" Margin="10,0,4,10"><TextBlock Text="员工" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="＋" Command="{Binding NewEmployeeCommand}" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="8,3" FontSize="17" AutomationProperties.Name="新建员工"/></Grid>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding EmployeeTimelines}" AutomationProperties.Name="员工列表"><ItemsControl.ItemTemplate><DataTemplate>
     <Button Command="{Binding DataContext.OpenEmployeeCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource EmployeeNavigation}" AutomationProperties.Name="{Binding Name}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="27" Height="29" Background="#E9EEE2" CornerRadius="6" VerticalAlignment="Top"><TextBlock Text="{Binding Initial}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding Role}" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Grid></Button>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel Grid.Row="4" Margin="4,14,4,0"><Border Background="#E4EBDD" Height="1" Margin="0,0,0,12"/><Button Content="项目目标与设置" Command="{Binding EditProjectCommand}" Style="{StaticResource Quiet}" HorizontalAlignment="Left"/><Button Content="＋ 新建项目" Command="{Binding NewProjectCommand}" Style="{StaticResource Quiet}" HorizontalAlignment="Left"/><TextBlock Text="本机工作区 · 记录与草稿持久保存" Style="{StaticResource Caption}" FontSize="10" Margin="8,12,0,0"/></StackPanel>
   </Grid></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#FFF1DA" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasPending,Converter={StaticResource Visible}}"><DockPanel><Button DockPanel.Dock="Right" Content="检查保存状态" Command="{Binding ResolvePendingCommand}" Style="{StaticResource Quiet}"/><Button DockPanel.Dock="Right" Content="返回员工工作区" Command="{Binding ResumeWorkCommand}" Style="{StaticResource Quiet}"/><TextBlock Text="有待确认的保存请求，原请求 ID 已保留。" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
    <views:OverviewView Grid.Row="1" x:Name="OverviewPanel" Visibility="{Binding IsOverview,Converter={StaticResource Visible}}"/>
    <views:EmployeeWorkspaceView Grid.Row="1" x:Name="EmployeePanel" Visibility="{Binding IsEmployeeWorkspace,Converter={StaticResource Visible}}"/>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Padding="22,8"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EAF0E3"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Background" Value="#FFE5DA"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><TextBlock DockPanel.Dock="Right" Text="处理中…" FontSize="10" Margin="16,0,0,0" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}"/><TextBlock Text="{Binding Status}" FontSize="10" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>
