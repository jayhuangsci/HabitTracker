<UserControl x:Class="PromptCrew.Desktop.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="2,0,0,20">
   <TextBlock Text="项目总览" FontSize="11" Foreground="#6B805B" Margin="0,0,0,7"/>
   <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding OverviewSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="20,0,0,0"/><TextBlock Text="{Binding OverviewTitle}" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
   <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Caption}" FontSize="12" MaxHeight="36" Margin="0,9,0,0"/>
   <TextBlock Text="每列是一名员工的工作记录，按时间从上到下连接。点击卡片查看完整内容。" Style="{StaticResource Caption}" Margin="0,9,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" x:Name="HistoryScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both" Visibility="{Binding HasTeam,Converter={StaticResource Visible}}">
   <ItemsControl ItemsSource="{Binding EmployeeTimelines}" Margin="0,0,0,12">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Width="252" Margin="0,0,14,0">
      <Button Command="{Binding DataContext.OpenEmployeeCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource LaneHeader}" AutomationProperties.Name="{Binding Name}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Role}" Style="{StaticResource Caption}" Margin="0,6,0,0"/><TextBlock Text="{Binding CountLabel}" Style="{StaticResource Caption}" Margin="0,9,0,0"/></StackPanel>
        <TextBlock Grid.Column="1" Text="↗" Foreground="#73866A" FontSize="16"/>
       </Grid>
      </Button>
      <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ActivityCardTemplate}"/>
      <Border Background="#EDF1E7" CornerRadius="9" Padding="18" Margin="18,0,0,0" Visibility="{Binding IsEmpty,Converter={StaticResource Visible}}"><TextBlock Text="暂无工作记录。点击员工，开始记录第一轮工作。" Style="{StaticResource Caption}"/></Border>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding HasNoTeam,Converter={StaticResource Visible}}">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"><TextBlock Text="把团队的工作过程留在这里" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="创建项目和员工后，每次保存的提示词与成果都会进入对应员工的历史链。" Style="{StaticResource Caption}" FontSize="13" Margin="0,16,0,20"/><StackPanel Orientation="Horizontal"><Button Content="创建项目" Command="{Binding NewProjectCommand}" Style="{StaticResource Primary}"/><Button Content="添加员工" Command="{Binding NewEmployeeCommand}" Margin="12,0,0,0"/></StackPanel></StackPanel>
  </Border>
 </Grid>
</UserControl>
