<UserControl x:Class="PromptCrew.Desktop.Views.QuickCaptureView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:PromptCrew.Desktop" KeyboardNavigation.TabNavigation="Cycle">
 <Grid Background="#60132720">
  <Border Background="White" BorderBrush="#D6E2D4" BorderThickness="1" CornerRadius="16" Width="610" HorizontalAlignment="Right" Margin="20" Padding="26" ui:Motion.Enabled="True">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="新一轮工作" Style="{StaticResource Caption}"/><TextBlock Text="{Binding QuickCaptureTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding QuickTaskLabel}" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Text="{Binding ParentLabel}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="关闭" Command="{Binding CloseQuickCaptureCommand}" Style="{StaticResource Quiet}" VerticalAlignment="Top" ToolTip="关闭后草稿仍保留（Esc）"/></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
    <Border Background="#F2F6EC" CornerRadius="10" Padding="14" Margin="0,0,0,18"><StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="开始新任务" Command="{Binding StartNewTaskCommand}" Style="{StaticResource Quiet}" Padding="8,4"/><TextBlock Text="{Binding QuickTaskLabel}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
     <ComboBox ItemsSource="{Binding Chains}" SelectedItem="{Binding SelectedChain}" DisplayMemberPath="Name" IsEnabled="{Binding CanEditQuick}" Margin="0,10,0,0" ToolTip="切换任务会分别保留草稿" AutomationProperties.Name="快速记录任务" Visibility="{Binding HasChains,Converter={StaticResource Visible}}"/>
     <StackPanel Visibility="{Binding IsNewTask,Converter={StaticResource Visible}}" Margin="0,10,0,0"><TextBlock Text="任务名称" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewTaskName,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanEditQuick,Converter={StaticResource Inverse}}" MaxLength="120" AutomationProperties.Name="新任务名称"/></StackPanel>
     <DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="设为首轮" Command="{Binding RootCommand}" Style="{StaticResource Quiet}" Padding="8,3"/><TextBlock Text="{Binding ParentLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
    </StackPanel></Border>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="本轮提示词" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" x:Name="PromptInput" Text="{Binding DraftInput,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanEditQuick,Converter={StaticResource Inverse}}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="15" Height="220" MinHeight="90" MaxLength="100000" AutomationProperties.Name="快速记录提示词"/></Grid>
    <Expander Grid.Row="3" Header="高级选项 · 模型、标签、引用与备注" Margin="0,16,0,12"><ScrollViewer MaxHeight="175" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,8,0" IsEnabled="{Binding CanEditQuick}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="模型名称（可选）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DraftModel,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="标签 · 逗号分隔" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DraftTags,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
     <TextBlock Text="引用轮次 ID · 须属于当前项目" Style="{StaticResource FieldLabel}" Margin="0,12,0,7"/><TextBox Text="{Binding DraftReferences,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"/>
     <TextBlock Text="备注" Style="{StaticResource FieldLabel}" Margin="0,12,0,7"/><TextBox Text="{Binding DraftNotes,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"/>
    </StackPanel></ScrollViewer></Expander>
    <Border Grid.Row="4" Background="#FFF1DA" Padding="12" CornerRadius="8" Margin="0,0,0,14" Visibility="{Binding HasPending,Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="请求已冻结保存。重试会使用原请求 ID 和相同内容。" TextWrapping="Wrap" FontSize="12"/><WrapPanel Margin="0,7,0,0"><Button Content="检查保存状态" Command="{Binding ResolvePendingCommand}" Style="{StaticResource Quiet}"/><Button Content="编辑未保存的草稿" Command="{Binding ReleasePendingCommand}" Style="{StaticResource Quiet}"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" Foreground="#855A20" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" Visibility="{Binding HasError,Converter={StaticResource Visible}}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="只保存输入也可以" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="先记为待输出，之后随时补充成果。" Style="{StaticResource Caption}" Margin="0,5,10,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消操作" Command="{Binding CancelCommand}" Style="{StaticResource Quiet}" Margin="0,0,8,0" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}"/><Button Content="保存提示词" Command="{Binding SaveQuickCommand}" Style="{StaticResource Primary}" AutomationProperties.Name="保存快速提示词" ToolTip="Ctrl+Enter 保存"/></StackPanel></Grid>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
