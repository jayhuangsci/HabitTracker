<UserControl x:Class="PromptCrew.Desktop.Views.EmployeeWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PromptCrew.Desktop.Views">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="员工工作区" FontSize="11" Foreground="#6B805B" Margin="0,0,0,6"/><TextBlock Text="{Binding WorkspaceTitle}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkspaceRole}" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>
   <Button Grid.Column="1" Content="＋ 记录提示词" Command="{Binding QuickCaptureCommand}" CommandParameter="{Binding ActiveEmployee.Id}" VerticalAlignment="Center" Style="{StaticResource Quiet}"/>
  </Grid>
  <TabControl Grid.Row="1" x:Name="EmployeeTabs" Background="Transparent" BorderThickness="0">
   <TabItem Header="工作记录"><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,16"><TextBlock Text="这名员工的开发历史" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="按时间查看提示词、成果与后续修订。" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>
     <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox ItemsSource="{Binding ActiveTimeline.Cards}" ItemTemplate="{StaticResource ActivityCardTemplate}" Style="{StaticResource HistoryList}"/><TextBlock Text="点击员工旁的 +，保存第一轮提示词。" Style="{StaticResource Caption}" Margin="0,16,0,0" Visibility="{Binding ActiveTimeline.IsEmpty,Converter={StaticResource Visible}}"/><Button Grid.Row="1" Content="加载更早记录" Command="{Binding LoadOlderCommand}" CommandParameter="{Binding ActiveEmployee.Id}" Visibility="{Binding ActiveTimeline.HasMore,Converter={StaticResource Visible}}" Style="{StaticResource Quiet}"/></Grid>
    </Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="职责" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveResponsibilities}" Style="{StaticResource Caption}" FontSize="12" Margin="0,12,0,22"/><TextBlock Text="参与的任务" FontSize="16" FontWeight="SemiBold"/>
     <ItemsControl ItemsSource="{Binding ParticipatingChains}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E4EADD" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Goal}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="进入任务与提示词  →" Click="GoEditor" Margin="0,22,0,0" Style="{StaticResource Primary}"/>
    </StackPanel></ScrollViewer></Border>
   </Grid></TabItem>
   <TabItem Header="任务与提示词"><views:TaskEditorView x:Name="TaskEditor" Margin="0,15,0,0"/></TabItem>
   <TabItem Header="职责与 Skills"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="0,15,0,0"><StackPanel><TextBlock Text="特定职责" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ActiveResponsibilities}" TextWrapping="Wrap" Margin="0,0,0,24"/><TextBlock Text="基础提示词" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ActiveBasePrompt,Mode=OneWay}" Style="{StaticResource ReadOnly}" MinHeight="180" MaxHeight="380"/><TextBlock Text="关联 Skills" Style="{StaticResource FieldLabel}" Margin="0,24,0,10"/><TextBlock Text="{Binding ActiveSkills}" TextWrapping="Wrap"/><Button Content="编辑员工配置" Command="{Binding EditEmployeeCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,24,0,0"/></StackPanel></Border></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
