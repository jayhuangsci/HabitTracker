<Window x:Class="PromptCrew.Desktop.CatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="650" Height="760" MinHeight="580" MinWidth="520" WindowStartupLocation="CenterOwner" Background="#F5F7F2" Foreground="#193729" FontFamily="Microsoft YaHei UI">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold"/><StackPanel Visibility="{Binding ShowTemplates,Converter={StaticResource Visible}}" Margin="0,16,0,0"><TextBlock Text="从示例职责开始，或直接自定义" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" AutomationProperties.Name="员工职责模板"/></StackPanel></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,10,16"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/><TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="{Binding Multiline}" VerticalScrollBarVisibility="Auto" MaxHeight="240" AutomationProperties.Name="{Binding Label}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="42"/><Style.Triggers><DataTrigger Binding="{Binding Multiline}" Value="True"><Setter Property="MinHeight" Value="92"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <ComboBox Grid.Row="2" ItemsSource="{Binding States}" SelectedItem="{Binding State}" DisplayMemberPath="Label" Margin="0,12,0,12" AutomationProperties.Name="启用状态"/>
  <DockPanel Grid.Row="3"><Button DockPanel.Dock="Right" Content="保存" Command="{Binding SaveCommand}" Background="#D2F580" Padding="25,12"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#936128"/></DockPanel>
 </Grid>
</Window>
