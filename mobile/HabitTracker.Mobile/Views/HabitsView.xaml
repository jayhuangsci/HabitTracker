<UserControl x:Class="HabitTracker.Mobile.Views.HabitsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Daily habits" Style="{StaticResource Title}" /><Button Grid.Column="1" Content="＋ New" Command="{Binding NewHabitCommand}" Style="{StaticResource Quiet}" /></Grid>
        <TextBlock Text="The everyday work that supports your training." Style="{StaticResource Caption}" Margin="0,0,0,20" />
        <TextBlock Text="Choose a habit" Style="{StaticResource Label}" Visibility="{Binding HasHabits, Converter={StaticResource Visible}}" /><ComboBox ItemsSource="{Binding Habits}" SelectedItem="{Binding SelectedHabit, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Habit" Margin="0,0,0,16" Visibility="{Binding HasHabits, Converter={StaticResource Visible}}" />
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Habit details" Style="{StaticResource Heading}" Margin="0,0,0,16" /><TextBlock Text="Name" Style="{StaticResource Label}" /><TextBox Text="{Binding HabitName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Habit name" /><TextBlock Text="Unit · km, hours, liters…" Style="{StaticResource Label}" Margin="0,16,0,7" /><TextBox Text="{Binding HabitUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Habit unit" /><TextBlock Text="Description · optional" Style="{StaticResource Label}" Margin="0,16,0,7" /><TextBox Text="{Binding HabitDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" TextWrapping="Wrap" AutomationProperties.Name="Habit description" /><Button Content="{Binding SaveHabitLabel}" Command="{Binding SaveHabitCommand}" Style="{StaticResource Primary}" Margin="0,16,0,0" /></StackPanel></Border>
        <StackPanel Visibility="{Binding HasSelectedHabit, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Log your day" Style="{StaticResource Heading}" Margin="0,0,0,16" /><TextBlock Text="Date" Style="{StaticResource Label}" /><DatePicker SelectedDate="{Binding HabitDate, Mode=TwoWay}" AutomationProperties.Name="Habit date" /><TextBlock Text="Quantity" Style="{StaticResource Label}" Margin="0,16,0,7" /><TextBox Text="{Binding HabitQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Habit quantity" /><TextBlock Text="Note · optional" Style="{StaticResource Label}" Margin="0,16,0,7" /><TextBox Text="{Binding HabitComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Habit note" /><Button Content="Save daily record" Command="{Binding LogHabitCommand}" Style="{StaticResource Dark}" Margin="0,16,0,0" /><TextBlock Text="{Binding HabitLogHint}" Style="{StaticResource Caption}" FontSize="10" Margin="0,12,0,0" /></StackPanel></Border>
            <TextBlock Text="Recent records" Style="{StaticResource Heading}" Margin="0,6,0,14" /><ItemsControl ItemsSource="{Binding HabitLogs}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding QuantityLabel}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding DateLabel}" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" /><TextBlock Text="{Binding Log.Comment}" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" /></StackPanel><Button Grid.Column="1" Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource Quiet}" Foreground="#956126" FontSize="11" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Button Content="Delete habit and its records" Command="{Binding DeleteHabitCommand}" Style="{StaticResource Quiet}" Foreground="#956126" Margin="0,8,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
