<UserControl x:Class="HabitTracker.Mobile.Views.ProgressView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Stronger, over time." Style="{StaticResource Title}" /><TextBlock Text="A clear view of the effort behind your progress." Style="{StaticResource Caption}" Margin="0,8,0,20" />
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="The work adds up." Style="{StaticResource Heading}" /><StackPanel Orientation="Horizontal" Margin="0,10,0,4"><TextBlock Text="{Binding VolumeThisWeek}" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="lb this week" Style="{StaticResource Caption}" Margin="8,17,0,0" /></StackPanel>
            <TextBlock Text="8 calendar weeks · completed working sets" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,16" />
            <ItemsControl ItemsSource="{Binding Chart}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Width="31" Margin="1,0"><Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="24" /></Grid.RowDefinitions><Border Height="{Binding Height}" Width="20" CornerRadius="4,4,0,0" VerticalAlignment="Bottom" Background="{Binding Current, Converter={StaticResource BoolBrush}, ConverterParameter=#C9ED7C|#71966B}" ToolTipService.ToolTip="{Binding Detail}" /><TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="8" Foreground="#718269" TextAlignment="Center" VerticalAlignment="Bottom" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="All units are normalized to pounds. Warmups and unfinished sessions are excluded." Style="{StaticResource Caption}" FontSize="10" Margin="0,16,0,0" />
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Personal bests" Style="{StaticResource Heading}" /><TextBlock Text="Heaviest working load · completed sessions" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,10" />
            <TextBlock Text="Finish a workout to see your first personal best." Style="{StaticResource Caption}" Margin="0,12,0,0" Visibility="{Binding HasRecords, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            <ItemsControl ItemsSource="{Binding Records}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E8EDDF" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ExerciseName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" /><TextBlock Text="{Binding EstimateLabel}" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding WeightLabel}" FontWeight="SemiBold" FontSize="19" Margin="12,0,0,0" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Epley estimates use sets of 1–12 reps. They are training estimates, not tested maximums." Style="{StaticResource Caption}" FontSize="10" Margin="0,14,0,0" />
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Where the work goes" Style="{StaticResource Heading}" /><TextBlock Text="Working sets by primary muscle · last 28 days" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,20" /><ItemsControl ItemsSource="{Binding Muscles}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,20"><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Sets, StringFormat='{0} sets'}" Style="{StaticResource Caption}" FontSize="11" /></Grid><ProgressBar Value="{Binding Fraction, Mode=OneWay}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border Style="{StaticResource Card}" Background="#EDF3E1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="75" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your weekly goal" FontWeight="SemiBold" /><TextBlock Text="Completed sessions per week" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,12,0" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding GoalOptions}" SelectedItem="{Binding WeeklyGoal, Mode=TwoWay}" AutomationProperties.Name="Weekly session goal" /></Grid></Border>
    </StackPanel>
</UserControl>
