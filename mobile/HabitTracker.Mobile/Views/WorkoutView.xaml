<UserControl x:Class="HabitTracker.Mobile.Views.WorkoutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HabitTracker.Mobile.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Workout studio" Style="{StaticResource Title}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Details" Style="{StaticResource Quiet}" Command="{Binding ToggleDetailsCommand}" AutomationProperties.Name="Session details" /></Grid>
        <TextBlock Text="{Binding SessionSummary}" Style="{StaticResource Caption}" Margin="0,0,0,18" />
        <Border Style="{StaticResource Card}" Visibility="{Binding ShowDetails, Converter={StaticResource Visible}}"><StackPanel IsEnabled="{Binding CanEditSession}">
            <TextBlock Text="Session name" Style="{StaticResource Label}" /><TextBox Text="{Binding WorkoutName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Session name" />
            <TextBlock Text="Date" Style="{StaticResource Label}" Margin="0,16,0,7" /><DatePicker SelectedDate="{Binding WorkoutDate, Mode=TwoWay}" AutomationProperties.Name="Workout date" />
            <TextBlock Text="Routine" Style="{StaticResource Label}" Margin="0,16,0,7" /><ComboBox ItemsSource="{Binding RoutineOptions}" SelectedItem="{Binding SelectedRoutine, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Routine" />
            <TextBlock Text="{Binding RoutineHint}" Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0" />
        </StackPanel></Border>
        <Border Background="#FFF0D9" CornerRadius="9" Padding="14" Margin="0,0,0,14" Visibility="{Binding HasPendingSave, Converter={StaticResource Visible}}"><TextBlock Text="A save is awaiting confirmation. Retry the same set or refresh to check the journal." TextWrapping="Wrap" FontSize="12" Foreground="#8B602F" /></Border>
        <StackPanel IsEnabled="{Binding CanEditDraft}">
            <TextBlock Text="Exercise" Style="{StaticResource Label}" /><ComboBox ItemsSource="{Binding ExerciseOptions}" SelectedItem="{Binding SelectedExercise, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,16" AutomationProperties.Name="Exercise" />
            <Border Style="{StaticResource Card}"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Plate builder" Style="{StaticResource Heading}" /><Button Grid.Column="1" Content="Clear" Command="{Binding ClearPlatesCommand}" Style="{StaticResource Quiet}" Margin="6,-8,-7,-8" /></Grid>
                <Border Background="#F0F5E4" CornerRadius="11" Padding="10,12" Margin="0,14,0,16"><StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding TotalLoad}" FontSize="48" FontWeight="SemiBold" /><TextBlock Text="{Binding UnitLabel}" FontSize="18" Foreground="#6F825C" Margin="7,26,0,0" /></StackPanel>
                    <TextBlock Text="{Binding BalanceLabel}" FontSize="11" HorizontalAlignment="Center" Foreground="#637D4C" />
                    <controls:BarbellVisual Load="{Binding Load}" Height="82" Margin="0,8" />
                    <TextBlock Text="{Binding LoadFormula}" FontSize="10" Foreground="#637D4C" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel></Border>
                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Units" Style="{StaticResource Label}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="lb" Command="{Binding SelectUnitCommand}" CommandParameter="lb" Background="{Binding IsPounds, Converter={StaticResource BoolBrush}}" AutomationProperties.Name="Pounds" /><Button Grid.Column="2" Content="kg" Command="{Binding SelectUnitCommand}" CommandParameter="kg" Background="{Binding IsKilograms, Converter={StaticResource BoolBrush}}" AutomationProperties.Name="Kilograms" /></Grid></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Bar weight" Style="{StaticResource Label}" /><TextBox x:Name="BarInput" Text="{Binding Bar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bar weight" /></StackPanel>
                </Grid>
                <TextBlock Text="LEFT SLEEVE · FROM THE BAR OUTWARD" Style="{StaticResource Label}" FontSize="10" />
                <TextBox Text="{Binding Left, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Left plates" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0"><ItemsControl ItemsSource="{Binding LeftChips}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding RemoveCommand}" Padding="10,7" MinHeight="44" MinWidth="44" FontSize="12" Margin="0,0,6,0" Background="#EAF2DC" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <ItemsControl ItemsSource="{Binding QuickPlates}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.AddLeftPlateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Weight}" Padding="8,7" MinWidth="44" FontSize="12" Margin="0,0,5,0" Background="White" BorderBrush="#D9E4CD" BorderThickness="1" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <CheckBox Content="Mirror plates on the right" IsChecked="{Binding Mirror, Mode=TwoWay}" Margin="0,12,0,8" AutomationProperties.Name="Mirror right side" />
                <StackPanel IsEnabled="{Binding CanEditRight}">
                    <TextBlock Text="RIGHT SLEEVE · INDEPENDENT SETUP" Style="{StaticResource Label}" FontSize="10" />
                    <TextBox Text="{Binding Right, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Right plates" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0"><ItemsControl ItemsSource="{Binding RightChips}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding RemoveCommand}" Padding="10,7" FontSize="12" Margin="0,0,6,0" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    <ItemsControl ItemsSource="{Binding QuickPlates}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.AddRightPlateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Weight}" Padding="8,7" MinWidth="44" FontSize="12" Margin="0,0,5,0" Background="White" BorderBrush="#D9E4CD" BorderThickness="1" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
                <TextBlock Text="Use + between plates, for example 45lbs+25lbs+10. Leave a sleeve empty for the bar only." Style="{StaticResource Caption}" FontSize="10" Margin="0,12,0,0" />
                <Border Background="#FFF0D9" CornerRadius="7" Padding="11" Margin="0,12,0,0" Visibility="{Binding IsUneven, Converter={StaticResource Visible}}"><TextBlock Text="The two sides have different weights. Check your physical setup before lifting." TextWrapping="Wrap" FontSize="11" Foreground="#8B602F" /></Border>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Make it a set." Style="{StaticResource Heading}" />
                <Grid Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reps" Style="{StaticResource Label}" /><TextBox x:Name="RepsInput" Text="{Binding Reps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Repetitions" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="RPE · optional" Style="{StaticResource Label}" /><TextBox x:Name="RpeInput" Text="{Binding Rpe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="RPE" /></StackPanel></Grid>
                <TextBlock Text="Set type" Style="{StaticResource Label}" /><ComboBox ItemsSource="{Binding SetKinds}" SelectedItem="{Binding Kind, Mode=TwoWay}" AutomationProperties.Name="Set type" />
                <TextBlock Text="Notes · optional" Style="{StaticResource Label}" Margin="0,16,0,7" /><TextBox Text="{Binding SetNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72" AutomationProperties.Name="Set notes" />
                <TextBlock Text="{Binding EntryValidation}" FontSize="11" Foreground="#956126" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding HasValidation, Converter={StaticResource Visible}}" />
            </StackPanel></Border>
        </StackPanel>
        <Border Style="{StaticResource Card}" Background="#EAF0DE"><StackPanel><TextBlock Text="REST TIMER" Style="{StaticResource Label}" FontSize="10" /><TextBlock Text="{Binding TimerLabel}" FontSize="40" FontWeight="SemiBold" /><TextBlock Text="{Binding TimerCaption}" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,14" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="{Binding TimerAction}" Command="{Binding TimerToggleCommand}" Background="White" /><Button Grid.Column="2" Content="+15s" Command="{Binding TimerAddCommand}" Background="White" /><Button Grid.Column="4" Content="Reset" Command="{Binding TimerResetCommand}" Background="White" /></Grid></StackPanel></Border>
        <TextBlock Text="This session" Style="{StaticResource Heading}" Margin="0,6,0,12" />
        <TextBlock Text="Your saved sets will appear here. Log the first one when you are ready." Style="{StaticResource Caption}" Margin="0,0,0,18" Visibility="{Binding HasSessionSets, Converter={StaticResource Visible}, ConverterParameter=invert}" />
        <ItemsControl ItemsSource="{Binding SessionSets}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding MainLine}" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,6" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11" /><TextBlock Text="{Binding PlateLine}" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0" /><TextBlock Text="{Binding BarLine}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0" /><Button Content="Remove set" Command="{Binding RemoveCommand}" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Foreground="#956126" Padding="0,8" Margin="0,6,0,-8" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
</UserControl>
