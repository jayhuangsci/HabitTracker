<UserControl x:Class="HabitTracker.Mobile.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Your training journal." Style="{StaticResource Title}" /><TextBlock Text="The full picture, down to every plate." Style="{StaticResource Caption}" Margin="0,8,0,20" />
        <TextBlock Text="Find a session or exercise" Style="{StaticResource Label}" /><TextBox Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search history" Margin="0,0,0,12" />
        <Button Content="Export / share CSV  ↓" Command="{Binding ExportCommand}" Style="{StaticResource Dark}" Margin="0,0,0,20" />
        <TextBlock Text="No sessions match your search. Log a workout or try another exercise name." Style="{StaticResource Caption}" Margin="0,10,0,20" Visibility="{Binding HasHistory, Converter={StaticResource Visible}, ConverterParameter=invert}" />
        <ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16"><StackPanel>
            <Button Command="{Binding ToggleCommand}" Background="Transparent" Padding="0,4" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" /><TextBlock Text="{Binding DateLabel}" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="＋" FontSize="22" VerticalAlignment="Center" Margin="10,0,0,0" /></Grid></Button>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,10,0,0" /><TextBlock Text="{Binding Status}" FontSize="10" Foreground="#6D8754" Margin="0,7,0,0" />
            <StackPanel Visibility="{Binding Expanded, Converter={StaticResource Visible}}" Margin="0,16,0,0">
                <Button Content="Resume session  →" Command="{Binding ResumeCommand}" Style="{StaticResource Primary}" Margin="0,0,0,12" Visibility="{Binding CanResume, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding VisibleSets}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F6F8F0" CornerRadius="9" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" /><TextBlock Text="{Binding MainLine}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,6" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11" /><TextBlock Text="{Binding PlateLine}" Style="{StaticResource Caption}" FontSize="11" Margin="0,9,0,0" /><TextBlock Text="{Binding BarLine}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0" /><TextBlock Text="{Binding Set.Notes}" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0" Visibility="{Binding HasNotes, Converter={StaticResource Visible}}" /><Button Content="Reuse this setup  →" Command="{Binding ReuseCommand}" Background="White" Margin="0,12,0,0" FontSize="12" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
</UserControl>
