<UserControl x:Class="HabitTracker.Mobile.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Make the next&#10;set count." Style="{StaticResource Title}" Margin="0,0,0,8" />
        <TextBlock Text="{Binding DateCaption}" Style="{StaticResource Caption}" Margin="0,0,0,20" />
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0" Padding="16"><StackPanel><TextBlock Text="SESSIONS" Style="{StaticResource Label}" FontSize="10" /><TextBlock Text="{Binding Sessions28}" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="last 28 days" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="16" Background="#ECF3DD"><StackPanel><TextBlock Text="VOLUME · LB" Style="{StaticResource Label}" FontSize="10" /><TextBlock Text="{Binding Volume28}" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="working sets · 28 days" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
        </Grid>
        <Button Content="＋  Start a workout" Command="{Binding StartWorkoutCommand}" CommandParameter="upper" Style="{StaticResource Dark}" MinHeight="50" Margin="0,0,0,18" AutomationProperties.Name="Start a workout" />
        <Border Style="{StaticResource Card}"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="A little consistency." Style="{StaticResource Heading}" /><TextBlock Grid.Column="1" Text="{Binding GoalLabel}" FontSize="23" FontWeight="SemiBold" Margin="12,0,0,0" /></Grid>
            <TextBlock Text="Sessions this week" Style="{StaticResource Caption}" Margin="0,6,0,14" />
            <ProgressBar Value="{Binding GoalFraction, Mode=OneWay}" />
            <ItemsControl ItemsSource="{Binding Days}" Margin="0,14,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Trained, Converter={StaticResource BoolBrush}}" Width="29" Height="29" CornerRadius="15" Margin="0,0,9,0"><TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding GoalMessage}" Style="{StaticResource Caption}" FontSize="11" />
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Background="#E6EFCF" BorderThickness="0"><StackPanel><TextBlock Text="BUILT FOR YOUR BAR" Style="{StaticResource Label}" FontSize="10" /><TextBlock Text="Every plate counts." FontSize="23" FontWeight="SemiBold" Margin="0,2,0,8" /><TextBlock Text="45 + 25 + 10. Each side. Keep the setup behind every lift." Style="{StaticResource Caption}" /><Button Content="Open the plate builder  →" Command="{Binding NavigateCommand}" CommandParameter="Workout" Style="{StaticResource Dark}" Margin="0,16,0,0" /></StackPanel></Border>
        <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="From your journal" Style="{StaticResource Heading}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="View all ↗" Style="{StaticResource Quiet}" Command="{Binding NavigateCommand}" CommandParameter="History" /></Grid>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasNoWorkouts, Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="Your first session belongs here." FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Log a set and it will stay in this journal, ready for your next workout." Style="{StaticResource Caption}" Margin="0,8,0,14" /><Button Content="Explore the demo" Command="{Binding UseDemoCommand}" Style="{StaticResource Primary}" /></StackPanel></Border>
        <ItemsControl ItemsSource="{Binding RecentWorkouts}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" /><TextBlock Grid.Column="1" Text="{Binding DateLabel}" Style="{StaticResource Caption}" FontSize="11" Margin="8,2,0,0" /></Grid><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,7,0,0" /><TextBlock Text="{Binding Status}" FontSize="10" Foreground="#6E8755" Margin="0,7,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="YOUR NEXT SESSION" Style="{StaticResource Label}" FontSize="10" Margin="0,10,0,10" />
        <ItemsControl ItemsSource="{Binding Routines}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding StartCommand}" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#DFE6D7" BorderThickness="1" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" FontSize="20" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
</UserControl>
