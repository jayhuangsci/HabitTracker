<UserControl x:Class="HabitTracker.Mobile.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Your journal, your way." Style="{StaticResource Title}" /><TextBlock Text="Choose where this app reads and saves your records." Style="{StaticResource Caption}" Margin="0,8,0,20" />
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Journal" Style="{StaticResource Heading}" /><TextBlock Text="Each journal keeps its records and unfinished workout separate." Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,16" />
            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedValue="{Binding SelectedMode, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="Journal mode" />
            <StackPanel Visibility="{Binding IsConnectedSelected, Converter={StaticResource Visible}}" Margin="0,18,0,0"><TextBlock Text="API base address" Style="{StaticResource Label}" /><TextBox Text="{Binding ApiAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="API address" /><TextBlock Text="Use HTTPS for a hosted service. An emulator or phone needs an address it can reach; localhost refers to that device." Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0" /></StackPanel>
            <Button Content="Open selected journal  →" Command="{Binding ApplySettingsCommand}" Style="{StaticResource Dark}" Margin="0,18,0,0" />
            <TextBlock Text="{Binding SourceDetail}" Style="{StaticResource Caption}" FontSize="11" Margin="0,14,0,0" />
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local" FontWeight="SemiBold" /><TextBlock Text="Your own records on this device. Log workouts without a desktop service. Browser records stay with this site's storage." Style="{StaticResource Caption}" Margin="0,8,0,18" /><TextBlock Text="Demo" FontWeight="SemiBold" /><TextBlock Text="Eight weeks of sample training. Try everything; your personal journal stays separate. Demo edits persist here." Style="{StaticResource Caption}" Margin="0,8,0,18" /><TextBlock Text="Connected" FontWeight="SemiBold" /><TextBlock Text="Read and save through your existing HabitTracker API. Local records are kept separate; journal modes do not automatically sync." Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel></Border>
        <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="75" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Weekly session goal" FontWeight="SemiBold" /><TextBlock Text="Make consistency your own." Style="{StaticResource Caption}" FontSize="11" Margin="0,6,12,0" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding GoalOptions}" SelectedItem="{Binding WeeklyGoal, Mode=TwoWay}" AutomationProperties.Name="Weekly goal setting" /></Grid></Border>
        <Button Content="✓  Daily habits  →" Command="{Binding NavigateCommand}" CommandParameter="Habits" HorizontalContentAlignment="Left" MinHeight="52" Background="White" BorderBrush="#DFE6D7" BorderThickness="1" Margin="0,0,0,12" />
        <Button Content="Export / share workout CSV  ↓" Command="{Binding ExportCommand}" HorizontalContentAlignment="Left" MinHeight="52" Background="White" BorderBrush="#DFE6D7" BorderThickness="1" />
        <TextBlock Text="CSV keeps your original units and plate stacks. Save a copy before clearing browser storage or uninstalling the app." Style="{StaticResource Caption}" FontSize="10" Margin="0,14,0,16" />
    </StackPanel>
</UserControl>
