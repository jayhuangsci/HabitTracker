<Project>
  <Import Project="../Directory.Build.props" />
  <ItemGroup>
    <!-- OpenSilver's compiler graph includes older crypto packages; select patched .NET 10 versions. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
  </ItemGroup>
</Project>
