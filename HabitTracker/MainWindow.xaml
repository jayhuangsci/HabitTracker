<Window x:Class="HabitTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Habit Tracker"
        Height="860"
        Width="1100"
        MinHeight="760"
        MinWidth="980">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="220" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Habit Name" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Unit" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Description" FontWeight="SemiBold" />

                <TextBox Grid.Row="2"
                         Grid.Column="0"
                         Height="32"
                         Text="{Binding NewHabitName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Grid.Row="2"
                         Grid.Column="2"
                         Height="32"
                         Text="{Binding NewHabitUnit, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Grid.Row="2"
                         Grid.Column="4"
                         Height="32"
                         Text="{Binding NewHabitDescription, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Row="2"
                        Grid.Column="6"
                        Height="32"
                        Content="Add Habit"
                        Command="{Binding AddHabitCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="16"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <TextBlock Text="Selected Habit"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <TextBlock Margin="0,32,0,0"
                           Foreground="#6B7280"
                           Text="Select a habit from the list to see details."
                           Visibility="{Binding HasNoSelectedHabit, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Grid Margin="0,32,0,0"
                      Visibility="{Binding IsViewingSelectedHabit, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Unit" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Description" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding SelectedHabit.Name}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedHabit.Unit}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedHabit.Description}" />

                    <Button Grid.Row="2"
                            Grid.Column="3"
                            Height="32"
                            Content="Edit"
                            Command="{Binding BeginEditSelectedHabitCommand}" />

                    <Button Grid.Row="2"
                            Grid.Column="5"
                            Height="32"
                            Content="Delete"
                            Command="{Binding DeleteSelectedHabitCommand}" />
                </Grid>

                <Grid Margin="0,32,0,0"
                      Visibility="{Binding IsEditingSelectedHabit, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Unit" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Description" FontWeight="SemiBold" />

                    <TextBox Grid.Row="2"
                             Grid.Column="0"
                             Height="32"
                             Text="{Binding EditHabitName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Height="32"
                             Text="{Binding EditHabitUnit, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Row="2"
                             Grid.Column="2"
                             Height="32"
                             Text="{Binding EditHabitDescription, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Row="2"
                            Grid.Column="3"
                            Height="32"
                            Content="Save"
                            Command="{Binding SaveSelectedHabitCommand}" />

                    <Button Grid.Row="2"
                            Grid.Column="5"
                            Height="32"
                            Content="Cancel"
                            Command="{Binding CancelEditSelectedHabitCommand}" />
                </Grid>
            </Grid>
        </Border>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Habits}"
                  SelectedItem="{Binding SelectedHabit}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="120" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="6"
                Padding="16"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Habit Logs"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <TextBlock Grid.Row="2"
                           Foreground="#6B7280"
                           Text="Select a habit to load and create logs."
                           Visibility="{Binding HasNoSelectedHabit, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Grid Grid.Row="2"
                      Visibility="{Binding HasSelectedHabit, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Date" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Quantity" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Comment" FontWeight="SemiBold" />

                    <DatePicker Grid.Row="2"
                                Grid.Column="0"
                                Height="32"
                                SelectedDate="{Binding NewLogDate}" />

                    <TextBox Grid.Row="2"
                             Grid.Column="2"
                             Height="32"
                             Text="{Binding NewLogQuantity}" />

                    <TextBox Grid.Row="2"
                             Grid.Column="4"
                             Height="32"
                             Text="{Binding NewLogComment, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Row="2"
                            Grid.Column="6"
                            Height="32"
                            Content="Add Log"
                            Command="{Binding AddHabitLogCommand}" />
                </Grid>

                <DataGrid Grid.Row="4"
                          ItemsSource="{Binding HabitLogs}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          Visibility="{Binding HasSelectedHabit, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70" />
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="140" />
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="120" />
                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" />
                        <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="8">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" />

            <Button DockPanel.Dock="Right"
                    Width="120"
                    Height="32"
                    Margin="12,0,0,0"
                    Content="Refresh"
                    Command="{Binding LoadHabitsCommand}" />
        </DockPanel>
    </Grid>
</Window>
