<Window x:Class="HabitTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Habit Tracker"
        Height="600"
        Width="900"
        MinHeight="500"
        MinWidth="760">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Habit Name" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Unit" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Description" FontWeight="SemiBold" />

                <TextBox Grid.Row="2"
                         Grid.Column="0"
                         Height="32"
                         Text="{Binding NewHabitName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Grid.Row="2"
                         Grid.Column="2"
                         Height="32"
                         Text="{Binding NewHabitUnit, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Grid.Row="2"
                         Grid.Column="4"
                         Height="32"
                         Text="{Binding NewHabitDescription, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Row="2"
                        Grid.Column="6"
                        Height="32"
                        Content="Add Habit"
                        Command="{Binding AddHabitCommand}" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Habits}"
                  SelectedItem="{Binding SelectedHabit}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="120" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" />

            <Button DockPanel.Dock="Right"
                    Width="120"
                    Height="32"
                    Margin="12,0,0,0"
                    Content="Refresh"
                    Command="{Binding LoadHabitsCommand}" />
        </DockPanel>
    </Grid>
</Window>
