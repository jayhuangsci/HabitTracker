<Window x:Class="HabitTracker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:HabitTracker.Views" Title="HabitTracker · Strength journal" Width="1440" Height="940" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#F5F7F2" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#A8BAB0" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="16,14" /><Setter Property="Margin" Value="0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="#2A4636" /><Setter Property="Foreground" Value="#D2F580" /></DataTrigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid x:Name="ShellRoot" Background="#F5F7F2"><Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#193729"><Grid Margin="20,32,20,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="50" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="12,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="▰" FontSize="27" Foreground="#D2F580" Margin="0,0,10,0" /><TextBlock Text="FORM" FontSize="28" FontWeight="Bold" Foreground="White" /></StackPanel><TextBlock Text="A HabitTracker journal" Foreground="#9BAF9F" FontSize="11" Margin="0,7,0,0" /></StackPanel>
            <StackPanel Grid.Row="2"><TextBlock Text="YOUR TRAINING" FontSize="10" Foreground="#849C88" Margin="16,0,0,14" />
                <Button Style="{StaticResource NavButton}" Tag="{Binding IsOverview}" Command="{Binding NavigateCommand}" CommandParameter="Overview" Content="◫    Overview" AutomationProperties.Name="Overview" />
                <Button Style="{StaticResource NavButton}" Tag="{Binding IsWorkout}" Command="{Binding NavigateCommand}" CommandParameter="Workout" Content="＋    Workout studio" AutomationProperties.Name="Workout studio" />
                <Button Style="{StaticResource NavButton}" Tag="{Binding IsHistory}" Command="{Binding NavigateCommand}" CommandParameter="History" Content="≡    Training history" AutomationProperties.Name="Training history" />
                <Button Style="{StaticResource NavButton}" Tag="{Binding IsProgress}" Command="{Binding NavigateCommand}" CommandParameter="Progress" Content="↗    Your progress" AutomationProperties.Name="Your progress" />
                <Border Height="1" Background="#35503D" Margin="12,24" /><Button Style="{StaticResource NavButton}" Tag="{Binding IsHabits}" Command="{Binding NavigateCommand}" CommandParameter="Habits" Content="✓    Daily habits" AutomationProperties.Name="Daily habits" />
            </StackPanel>
            <StackPanel Grid.Row="4"><Border Background="#254431" CornerRadius="10" Padding="16" Margin="0,0,0,24"><StackPanel><TextBlock Text="Small details.&#10;Stronger lifts." Foreground="#D5E5CD" FontWeight="SemiBold" FontSize="15" LineHeight="23" /><TextBlock Text="One set at a time." Foreground="#96AE96" FontSize="11" Margin="0,10,0,0" /></StackPanel></Border><StackPanel Orientation="Horizontal" Margin="10,0,0,0"><TextBlock Text="●" FontSize="9" Foreground="#C8EB7B" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="{Binding ConnectionLabel}" Foreground="#BAC9B9" FontSize="11" /></StackPanel><TextBlock Text="DESIGNED FOR THE LONG RUN" Foreground="#78917D" FontSize="8" Margin="10,12,0,0" /></StackPanel>
        </Grid></Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="#FCFDF9" BorderBrush="#E3E9DF" BorderThickness="0,0,0,1" Padding="32,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="TRAINING" Style="{StaticResource Caption}" FontSize="10" /><TextBlock Text=" / " Margin="12,0" Foreground="#B8C2B4" /><TextBlock Text="{Binding CurrentPage}" FontWeight="SemiBold" FontSize="12" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding TodayLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0" /><Border Background="#EAF2DA" CornerRadius="5" Padding="10,6"><TextBlock Text="{Binding WorkspaceLabel}" Foreground="#536A3C" FontSize="9" FontWeight="SemiBold" /></Border></StackPanel></Grid></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="32,26,32,30">
                <views:OverviewView Visibility="{Binding IsOverview, Converter={StaticResource BoolVisibility}}" />
                <views:WorkoutView Visibility="{Binding IsWorkout, Converter={StaticResource BoolVisibility}}" />
                <views:HistoryView Visibility="{Binding IsHistory, Converter={StaticResource BoolVisibility}}" />
                <views:ProgressView Visibility="{Binding IsProgress, Converter={StaticResource BoolVisibility}}" />
                <StackPanel Visibility="{Binding IsHabits, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Daily habits" Style="{StaticResource PageTitle}" /><TextBlock Text="The everyday work that supports your training." Style="{StaticResource Caption}" Margin="0,8,0,16" /><views:HabitsView DataContext="{Binding Habits}" Height="880" /></StackPanel>
            </Grid></ScrollViewer>
            <Border Grid.Row="2" Padding="32,10" BorderBrush="#E0E7DB" BorderThickness="0,1,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F8FAF4" /><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Background" Value="#FFF1DF" /></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,5" Margin="16,0,0,0" /><TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#61745B" VerticalAlignment="Center" TextWrapping="Wrap" /><TextBlock Text="Saving…" FontSize="11" Margin="10,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" /></DockPanel></Border>
        </Grid>
    </Grid>
</Window>

