<UserControl x:Class="HabitTracker.Views.ProgressView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HabitTracker.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="Stronger, over time." Style="{StaticResource PageTitle}" /><TextBlock Text="A clear view of the effort behind your progress." Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Weekly session goal" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" /><ComboBox ItemsSource="{Binding GoalOptions}" SelectedItem="{Binding WeeklyGoal}" Width="75" AutomationProperties.Name="Weekly session goal" /></StackPanel></Grid>
        <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding ThisWeekVolume}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="lb this week" Style="{StaticResource Caption}" Margin="8,10,0,0" /></StackPanel><TextBlock Text="Training volume" Style="{StaticResource Heading}" /></DockPanel><TextBlock Text="Completed sessions · working sets only · all units converted to pounds" Style="{StaticResource Caption}" Margin="0,6,0,8" /><controls:VolumeChart Points="{Binding ChartPoints}" Height="235" /></StackPanel></Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Personal bests" Style="{StaticResource Heading}" /><TextBlock Text="Heaviest working load and estimated one-rep max" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,18" />
                <ItemsControl ItemsSource="{Binding Records}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EDF1E8" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ExerciseName}" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="{Binding EstimateLabel}" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding WeightLabel}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="Epley estimates use sets of 1–12 reps. They are training estimates, not tested maximums. Warmups are excluded." FontSize="10" Foreground="#7D8D72" TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Where the work goes" Style="{StaticResource Heading}" /><TextBlock Text="Working sets by primary muscle · last 28 days" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,22" /><ItemsControl ItemsSource="{Binding Muscles}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,24"><DockPanel Margin="0,0,0,9"><TextBlock Text="{Binding Sets, StringFormat={}{0} sets}" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Caption}" FontSize="11" /><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" /></DockPanel><ProgressBar Value="{Binding Fraction, Mode=OneWay}" Height="8" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Only completed sessions count toward progress. Finish your session to see it here." FontSize="11" Foreground="#7D8D72" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border>
        </Grid>
    </StackPanel>
</UserControl>

