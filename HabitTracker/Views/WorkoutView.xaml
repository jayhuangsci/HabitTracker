<UserControl x:Class="HabitTracker.Views.WorkoutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HabitTracker.Controls">
  <StackPanel>
    <TextBlock Text="Workout studio" Style="{StaticResource PageTitle}" />
    <TextBlock Text="Your bar. Your plates. Every set, exactly as you lifted it." Style="{StaticResource Caption}" Margin="0,8,0,24" />
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.3*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Session name" Style="{StaticResource Label}" />
          <TextBox Text="{Binding WorkoutName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasNoActiveWorkout}" MaxLength="100" AutomationProperties.Name="Session name" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Date" Style="{StaticResource Label}" />
          <DatePicker SelectedDate="{Binding WorkoutDate}" Height="40" IsEnabled="{Binding HasNoActiveWorkout}" AutomationProperties.Name="Workout date" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="Routine" Style="{StaticResource Label}" />
          <ComboBox ItemsSource="{Binding Routines}" SelectedItem="{Binding SelectedRoutine}" DisplayMemberPath="Name" IsEnabled="{Binding HasNoActiveWorkout}" AutomationProperties.Name="Routine" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.3*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="Plate builder" Style="{StaticResource Heading}" />
              <TextBlock Text="PER SIDE" FontSize="10" Foreground="#769061" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
            <Border Background="#F3F6EB" CornerRadius="10" Margin="0,16,0,20" Padding="16,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding TotalLoadLabel}" FontSize="40" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding UnitSymbol}" FontSize="18" Margin="8,26,0,0" Foreground="#73815E" />
                </StackPanel>
                <TextBlock Text="{Binding BalanceLabel}" HorizontalAlignment="Center" FontSize="11" Foreground="#6C815B" />
                <controls:PlateVisual Load="{Binding LoadPreview}" Height="85" Margin="0,6,0,0" />
                <TextBlock Text="{Binding LoadFormula}" HorizontalAlignment="Center" FontSize="10" Foreground="#6C815B" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Units" Style="{StaticResource Label}" />
                <ComboBox ItemsSource="{Binding Units}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Unit}" AutomationProperties.Name="Weight unit" ToolTip="Changing units loads the standard bar and a sample plate setup in that unit." />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Bar weight" Style="{StaticResource Label}" />
                <TextBox Text="{Binding BarWeight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bar weight" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Left sleeve · plates from the bar outward" Style="{StaticResource Label}" />
            <TextBox Text="{Binding LeftStack, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Left plate stack" ToolTip="Example: 45lbs+25lbs+10. Leave empty for the bar only." />
            <CheckBox Content="Mirror plates on the right side" IsChecked="{Binding Mirror}" Margin="0,14,0,14" AutomationProperties.Name="Mirror right side" />
            <TextBlock Text="Right sleeve · used when mirroring is off" Style="{StaticResource Label}" />
            <TextBox Text="{Binding RightStack, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IndependentSides}" AutomationProperties.Name="Right plate stack" />
            <TextBlock Text="{Binding LoadError}" Foreground="#A65C28" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
            <Border Background="#FFF0D6" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="{Binding HasImbalance, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="The two sides have different weights. Check your physical setup before lifting." Foreground="#8D602F" FontSize="11" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="Make it a set." Style="{StaticResource Heading}" />
            <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Margin="0,16,0,0">
              <TextBlock Text="Exercise" Style="{StaticResource Label}" />
              <ComboBox ItemsSource="{Binding Exercises}" SelectedItem="{Binding SelectedExercise}" DisplayMemberPath="Name" AutomationProperties.Name="Exercise" />
              <TextBlock Text="{Binding RoutineExerciseNames}" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            <Grid Margin="0,18,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.3*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Reps" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Reps, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Repetitions" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="RPE · optional" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Rpe, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="RPE" ToolTip="Rate of perceived exertion, 1 to 10." />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Set type" Style="{StaticResource Label}" />
                <ComboBox ItemsSource="{Binding SetKinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Set type" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Set notes · optional" Style="{StaticResource Label}" />
            <TextBox Text="{Binding SetNotes, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Set notes" />
            <Button Content="＋  Log set" Command="{Binding AddSetCommand}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Padding="16,14" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,18" Background="#EAF0E0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="REST TIMER" FontSize="10" Foreground="#758264" />
              <TextBlock Text="{Binding TimerLabel}" FontSize="36" FontWeight="SemiBold" Margin="0,4,0,4" />
              <TextBlock Text="{Binding TimerCaption}" FontSize="10" Foreground="#758264" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <Button Content="{Binding TimerButtonLabel}" Command="{Binding TimerCommand}" Background="White" Padding="18,8" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="+15s" Command="{Binding AddTimeCommand}" Padding="8,5" FontSize="10" />
                <Button Content="Reset" Command="{Binding ResetTimerCommand}" Padding="8,5" FontSize="10" Margin="5,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="This session" Style="{StaticResource Heading}" />
            <TextBlock Text="{Binding SessionCaption}" FontSize="11" Foreground="#70816B" Margin="0,7,0,16" TextWrapping="Wrap" />
            <DataGrid ItemsSource="{Binding SessionSets}" SelectedItem="{Binding SelectedSessionSet}" Height="130" AutomationProperties.Name="Saved sets">
              <DataGrid.Columns>
                <DataGridTextColumn Header="EXERCISE" Binding="{Binding ExerciseName}" Width="*" />
                <DataGridTextColumn Header="LOAD" Binding="{Binding LoadLabel}" Width="76" />
                <DataGridTextColumn Header="REPS" Binding="{Binding Reps}" Width="50" />
                <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="65" />
              </DataGrid.Columns>
            </DataGrid>
            <Button Content="Remove selected set" Command="{Binding RemoveSetCommand}" HorizontalAlignment="Left" Background="Transparent" FontSize="11" Padding="0,12" />
            <Button Content="Finish workout  ✓" Command="{Binding FinishCommand}" Style="{StaticResource DarkButton}" Padding="16,14" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
