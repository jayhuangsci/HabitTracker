<UserControl x:Class="HabitTracker.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HabitTracker.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,26"><StackPanel><TextBlock Text="Your training, in focus." Style="{StaticResource PageTitle}" /><TextBlock Text="Show up. Put in the work. See it add up." Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel><Button Content="＋  Start a workout" Style="{StaticResource DarkButton}" Command="{Binding StartRoutineCommand}" CommandParameter="upper" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
        <UniformGrid Columns="3" Margin="0,0,-16,22">
            <Border Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="SESSIONS" Style="{StaticResource Caption}" FontSize="10" /><TextBlock Text="{Binding SessionsLabel}" FontSize="35" FontWeight="SemiBold" Margin="0,10,0,6" /><TextBlock Text="Completed in the last 28 days" Style="{StaticResource Caption}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="TRAINING VOLUME" Style="{StaticResource Caption}" FontSize="10" /><StackPanel Orientation="Horizontal" Margin="0,10,0,6"><TextBlock Text="{Binding VolumeLabel}" FontSize="35" FontWeight="SemiBold" /><TextBlock Text="lb" Margin="8,16,0,0" Style="{StaticResource Caption}" /></StackPanel><TextBlock Text="Working sets · last 28 days" Style="{StaticResource Caption}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" Background="#ECF3DD"><StackPanel><TextBlock Text="HEAVIEST LIFT" Style="{StaticResource Caption}" FontSize="10" /><TextBlock Text="{Binding BestWeightLabel}" FontSize="35" FontWeight="SemiBold" Margin="0,10,0,6" /><TextBlock Text="{Binding BestLiftCaption}" Style="{StaticResource Caption}" /></StackPanel></Border>
        </UniformGrid>
        <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="1.9*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="The work adds up" Style="{StaticResource Heading}" /><TextBlock Text="8 WEEKS · LB" HorizontalAlignment="Right" FontSize="10" Foreground="#7D8C75" VerticalAlignment="Center" /></DockPanel><TextBlock Text="Weekly volume, excluding warmup sets" Style="{StaticResource Caption}" Margin="0,6,0,8" /><controls:VolumeChart Points="{Binding ChartPoints}" Height="195" AutomationProperties.Name="Weekly working-set volume over the last eight weeks" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="A little consistency." Style="{StaticResource Heading}" /><TextBlock Text="Your sessions this week" Style="{StaticResource Caption}" Margin="0,6,0,0" /><StackPanel Orientation="Horizontal" Margin="0,18,0,12"><TextBlock Text="{Binding GoalLabel}" FontSize="38" FontWeight="SemiBold" /><TextBlock Text="sessions" Style="{StaticResource Caption}" Margin="10,21,0,0" /></StackPanel><ProgressBar Value="{Binding GoalFraction, Mode=OneWay}" /><ItemsControl ItemsSource="{Binding TrainingDays}" Margin="0,18,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="13" Height="28" Width="28"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0F3E9" /><Style.Triggers><DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="Background" Value="#D2F580" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding GoalMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0" /></StackPanel></Border>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.9*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="View history ↗" Command="{Binding NavigateCommand}" CommandParameter="History" Padding="10,5" Background="Transparent" /><TextBlock Text="From your journal" Style="{StaticResource Heading}" /></DockPanel><TextBlock Text="Your first session belongs here. Start a workout to begin." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,20" Visibility="{Binding HasNoWorkouts, Converter={StaticResource BoolVisibility}}" /><DataGrid ItemsSource="{Binding RecentWorkouts}" Height="245" Visibility="{Binding HasWorkouts, Converter={StaticResource BoolVisibility}}"><DataGrid.Columns><DataGridTextColumn Header="SESSION" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="DATE" Binding="{Binding DateLabel}" Width="115" /><DataGridTextColumn Header="SETS" Binding="{Binding SetCount}" Width="52" /><DataGridTextColumn Header="VOLUME" Binding="{Binding VolumeLabel}" Width="100" /></DataGrid.Columns></DataGrid></StackPanel></Border>
            <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}" Background="#E6EFCF" BorderThickness="0" Padding="22"><StackPanel><TextBlock Text="BUILT FOR YOUR BAR" FontSize="10" Foreground="#58703D" /><TextBlock Text="Every plate counts." FontSize="23" FontWeight="SemiBold" Margin="0,10,0,8" /><TextBlock Text="45 + 25 + 10. Each side.&#10;Keep the setup behind every lift." Foreground="#56704C" FontSize="12" LineHeight="20" /><controls:PlateVisual Load="{Binding LoadPreview}" Height="102" Margin="0,4" /><Button Content="Open the plate builder  →" Style="{StaticResource DarkButton}" Command="{Binding NavigateCommand}" CommandParameter="Workout" Padding="12,10" /></StackPanel></Border><Button Content="Explore your progress  ↗" Command="{Binding NavigateCommand}" CommandParameter="Progress" Margin="0,14,0,0" Background="Transparent" HorizontalContentAlignment="Left" /></StackPanel>
        </Grid>
    </StackPanel>
</UserControl>

