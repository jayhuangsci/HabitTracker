<UserControl x:Class="HabitTracker.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" Content="Export journal ↓" Command="{Binding ExportCommand}" Style="{StaticResource DarkButton}" VerticalAlignment="Center" /><StackPanel><TextBlock Text="Your training history." Style="{StaticResource PageTitle}" /><TextBlock Text="The full picture, down to the plates on your bar." Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel></DockPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Find a session or exercise" Style="{StaticResource Label}" /><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search training history" Margin="0,0,0,18" />
            <DataGrid ItemsSource="{Binding FilteredWorkouts}" SelectedItem="{Binding SelectedHistory}" Height="285" AutomationProperties.Name="Training sessions"><DataGrid.Columns><DataGridTextColumn Header="SESSION" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="DATE" Binding="{Binding DateLabel}" Width="150" /><DataGridTextColumn Header="SETS" Binding="{Binding SetCount}" Width="80" /><DataGridTextColumn Header="VOLUME" Binding="{Binding VolumeLabel}" Width="140" /><DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="120" /></DataGrid.Columns></DataGrid>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasSelectedHistory, Converter={StaticResource BoolVisibility}}"><StackPanel><DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Resume session" Command="{Binding ResumeCommand}" Margin="0,0,10,0" /><Button Content="Reuse selected setup →" Command="{Binding CopyLoadCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel><StackPanel><TextBlock Text="{Binding SelectedHistory.Name}" Style="{StaticResource Heading}" /><TextBlock Text="Select a set to reuse its exact plate configuration." Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" /></StackPanel></DockPanel>
            <DataGrid ItemsSource="{Binding HistorySets}" SelectedItem="{Binding SelectedHistorySet}" Height="295" AutomationProperties.Name="Historical sets"><DataGrid.Columns><DataGridTextColumn Header="EXERCISE" Binding="{Binding ExerciseName}" Width="190" /><DataGridTextColumn Header="LOAD" Binding="{Binding LoadLabel}" Width="90" /><DataGridTextColumn Header="PLATE SETUP" Binding="{Binding PlateLabel}" Width="*" MinWidth="180" /><DataGridTextColumn Header="REPS" Binding="{Binding Reps}" Width="55" /><DataGridTextColumn Header="RPE" Binding="{Binding Rpe}" Width="50" /><DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="75" /></DataGrid.Columns></DataGrid>
        </StackPanel></Border>
    </StackPanel>
</UserControl>
